<section class="messages">
  <div class="message_header">
    <div class="privacy_icon_wrap">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon">
        <path
          d="M12,12H19C18.47,16.11 15.72,19.78 12,20.92V12H5V6.3L12,3.19M12,1L3,5V11C3,16.55 6.84,21.73 12,23C17.16,21.73 21,16.55 21,11V5L12,1Z"
        />
      </svg>
    </div>
    <div class="message_heading_wrap">
      <div>
        <h1>Messages</h1>
        <p><%= rows.length %> messages on the clubhouse</p>
      </div>
      
      <a href="/message" class="add_msg_wrap">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="white"
          class="icon"
        >
          <path
            d="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2Z"
          />
        </svg>
        Add message
      </a>
    </div>
  </div>
</section>
