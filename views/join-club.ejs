<div>
    
    <form action="/join-club/member" method="POST" class="passcode_form">
    <h2>Member</h2>
    
    <% const error = locals.error %>

    <% if(error.member){%>   
        <div class="error_wrap">
            <li> <%= error.member %>. </li>
        </div>
    <% } %>

    <div class="input_wrap">
      <p>Enter member passcode to become a member</p>

      <p class="hint">Hint: The more you take away from me the more i get bigger. what am I?</p>

      <label for="passcode">Passcode</label>
      <input type="text" placeholder="passcode" name="passcode" />
    </div>

    <button class="submit_btn">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon"
      >
        <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5" />

        <polyline points="16 17 21 12 16 7" />

        <line x1="21" y1="12" x2="9" y2="12" />
      </svg>
      Submit
    </button>
    
  </form>
  
  <form action="/join-club/admin" method="POST" class="passcode_form passcode_form_admin">
    <h2>Admin</h2>

    <% if(error.admin){%>
        <div class="error_wrap">
            <li> <%= error.admin %>. </li>
        </div>
    <% } %>

    <div class="input_wrap">
      <p>Enter admin passcode to become an admin</p>
      <label for="passcode">Passcode</label>
      <input type="text" placeholder="passcode" name="passcode" />
    </div>

    <button class="submit_btn">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon"
      >
        <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5" />

        <polyline points="16 17 21 12 16 7" />

        <line x1="21" y1="12" x2="9" y2="12" />
      </svg>
      Submit
    </button>
    
  </form>
</div>
