<header>
  <!-- Add condition to check that the logout button only show when user is logged in -->
  <section class="logo">
    <a href="/">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="logo_icon"
        fill="var(--sec-accent)"
      >
        <path
          d="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2Z"
        />
      </svg>
      Clubhouse
    </a>
  </section>
  <nav>
    <a href="/" class="home_wrap">
      <svg
        class="icon"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M3 10.5L12 3l9 7.5" />
        <path d="M5 9.5V20h14V9.5" />
        <path d="M10 20v-6h4v6" />
      </svg>
      Home
    </a>

    <a href="/join-club" class="join_club_wrap">
      <svg
        class="icon"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" />
        <circle cx="9.5" cy="7" r="4" />

        <line x1="19" y1="8" x2="19" y2="14" />
        <line x1="16" y1="11" x2="22" y2="11" />
      </svg>
      Join club
    </a>

    <a href="/log-in" class="login_wrap">
      <svg
        class="icon"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <!-- Door -->
        <path d="M4 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4" />

        <!-- Login Arrow -->
        <path d="M14 12h7" />
        <path d="M18 8l4 4-4 4" />
      </svg>
      Log in
    </a>
  </nav>
